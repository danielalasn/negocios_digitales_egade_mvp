# Prisma / PostgreSQL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWKS_URL="https://[project-ref].supabase.co/auth/v1/.well-known/jwks.json"

# Google Gemini Vision API (server-only, never NEXT_PUBLIC_)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Optional: USD per 1M tokens, to compute real cost per photo in the admin panel
GEMINI_PRICE_INPUT_USD_PER_M=""
GEMINI_PRICE_OUTPUT_USD_PER_M=""

# Comma-separated emails allowed to open /admin/piloto
ADMIN_EMAILS="you@example.com"
